rules_version = '2';

// ============================================================================
// CTC — Regras de segurança do Firestore (Fase 1 + Backup + Suporte + Auditoria + Empresas + Confirmação de acesso + Escrituração + Parametrização + Listas de exercícios, 04/10/2026)
// Cole este arquivo inteiro em: Console Firebase > Firestore > Regras > Publicar
//
// Quem é quem:
//  - Administrador e Professor: e-mail cadastrado em autorizados/{email}
//    (papel "admin" ou "professor"). Não existe código de acesso.
//  - Aluno: qualquer conta Google que tenha vinculado uma matrícula que o
//    professor incluiu na lista de uma turma.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- funções de apoio ----------
    function logado() {
      return request.auth != null && request.auth.token.email != null;
    }
    function meuEmail() {
      return request.auth.token.email.lower();
    }
    function autorizado() {
      return logado() && exists(/databases/$(database)/documents/autorizados/$(meuEmail()));
    }
    function papel() {
      return get(/databases/$(database)/documents/autorizados/$(meuEmail())).data.papel;
    }
    // confirmação a cada entrada: senha (professor/admin) ou matrícula (aluno),
    // gravada em sessoes/{uid} e válida por no máximo 12 horas
    function sessaoValida(tipo) {
      let caminho = /databases/$(database)/documents/sessoes/$(request.auth.uid);
      return exists(caminho) && get(caminho).data.tipo == tipo && get(caminho).data.validoAte > request.time;
    }
    function confirmado() {
      return logado() && (sessaoValida('professor') || sessaoValida('aluno'));
    }
    function souAdmin() {
      return autorizado() && papel() == 'admin' && sessaoValida('professor');
    }
    function souProfessor() {
      // administrador também pode tudo o que o professor pode
      return autorizado() && papel() in ['professor', 'admin'] && sessaoValida('professor');
    }
    function minhaMatricula() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('matricula', '');
    }
    function souProfessorDaTurma(turmaId) {
      return souAdmin() || (souProfessor() &&
        get(/databases/$(database)/documents/turmas/$(turmaId)).data.professorUid == request.auth.uid);
    }
    function souAlunoDaTurma(turmaId) {
      let m = minhaMatricula();
      return logado() && m != '' && sessaoValida('aluno') &&
        exists(/databases/$(database)/documents/turmas/$(turmaId)/alunos/$(m)) &&
        get(/databases/$(database)/documents/matriculas/$(m)).data.get('uid', null) == request.auth.uid;
    }

    function sessaoProfessorConfere() {
      let segredo = /databases/$(database)/documents/segredos/$(meuEmail());
      return request.resource.data.tipo == 'professor' && autorizado() && exists(segredo) &&
        request.resource.data.prova == get(segredo).data.senhaHash;
    }
    function sessaoAlunoConfere() {
      let m = minhaMatricula();
      return request.resource.data.tipo == 'aluno' && m != '' &&
        request.resource.data.matricula == m &&
        get(/databases/$(database)/documents/matriculas/$(m)).data.get('uid', null) == request.auth.uid;
    }

    // ---------- professores e administradores autorizados ----------
    match /autorizados/{email} {
      // cada pessoa pode ver o próprio registro; o administrador vê todos
      allow read: if logado() && (email == meuEmail() || souAdmin());
      // só o administrador inclui ou remove (o primeiro é criado pelo Console)
      allow write: if souAdmin();
    }

    // ---------- perfil de cada usuário ----------
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || souProfessor());
      // o próprio aluno cria/atualiza o perfil; a matrícula só pode ser gravada
      // se, ao final da mesma operação, a matrícula estiver vinculada a ele
      // o administrador regrava perfis ao restaurar um backup
      allow write: if souAdmin();
      allow create, update: if logado() && request.auth.uid == uid &&
        (request.resource.data.get('matricula', '') == '' ||
         getAfter(/databases/$(database)/documents/matriculas/$(request.resource.data.matricula)).data.get('uid', null) == request.auth.uid);
      allow delete: if souAdmin();
    }

    // ---------- matrículas (índice de todos os alunos das listas) ----------
    match /matriculas/{matricula} {
      // buscar UMA matrícula (primeiro acesso) qualquer pessoa logada pode;
      // listar todas, só professor
      allow get: if logado();
      allow list: if souProfessor();
      // o professor inclui, atualiza ou desvincula
      allow create, delete: if souProfessor();
      allow update: if souProfessor() ||
        // o aluno vincula a matrícula livre à própria conta, e nada além disso
        (logado() &&
         resource.data.get('uid', null) == null &&
         request.resource.data.uid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'vinculadoEm']));
    }

    // ---------- turmas ----------
    match /turmas/{turmaId} {
      allow read: if souProfessor() || souAlunoDaTurma(turmaId);
      // professor cria a própria turma; o administrador também recria turmas ao restaurar um backup
      allow create: if souAdmin() || (souProfessor() && request.resource.data.professorUid == request.auth.uid);
      allow update, delete: if souProfessorDaTurma(turmaId);

      match /alunos/{matricula} {
        allow read: if souProfessorDaTurma(turmaId) ||
          (souAlunoDaTurma(turmaId) && matricula == minhaMatricula());
        // a lista pode ser gravada junto com a criação da turma (ou com a exclusão),
        // por isso confere a turma antes e depois da gravação
        allow write: if souAdmin() || (souProfessor() && (
          (exists(/databases/$(database)/documents/turmas/$(turmaId)) &&
           get(/databases/$(database)/documents/turmas/$(turmaId)).data.professorUid == request.auth.uid) ||
          (existsAfter(/databases/$(database)/documents/turmas/$(turmaId)) &&
           getAfter(/databases/$(database)/documents/turmas/$(turmaId)).data.professorUid == request.auth.uid)));
      }

      // listas de exercícios: o professor monta; o aluno da turma vê só as enviadas
      match /listas/{listaId} {
        allow read: if souProfessorDaTurma(turmaId) ||
          (souAlunoDaTurma(turmaId) && resource.data.enviada == true);
        allow create, update, delete: if souProfessorDaTurma(turmaId);
      }
    }

    // ---------- Banco de Dados comum ----------
    // plano de contas, cronograma IBS/CBS e outras tabelas de referência
    match /config/{docId} {
      allow read: if confirmado();
      allow write: if souProfessor() && (docId == 'planoContas' || souAdmin());
    }

    // histórico de alterações: ninguém altera nem apaga um registro
    match /historico/{id} {
      allow read: if souProfessor();
      allow create: if souProfessor() && request.resource.data.porUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- empresa individual do aluno (uma por turma) ----------
    // o código do documento é {turmaId}_{matricula}
    match /empresas/{id} {
      function turmaDaEmpresa() { return id.split('_')[0]; }
      function matriculaDaEmpresa() { return id.split('_')[1]; }
      function minhaEmpresa() {
        return souAlunoDaTurma(turmaDaEmpresa()) && matriculaDaEmpresa() == minhaMatricula();
      }
      allow get: if souProfessorDaTurma(turmaDaEmpresa()) || minhaEmpresa();
      allow list: if souAdmin();
      allow create, update: if (souProfessorDaTurma(turmaDaEmpresa()) ||
          (minhaEmpresa() && !alunoDestravando())) &&
        request.resource.data.turmaId == turmaDaEmpresa() &&
        request.resource.data.matricula == matriculaDaEmpresa();
      // só o professor destrava a parametrização de quem já tem lançamentos
      function alunoDestravando() {
        return request.resource.data.get('parametrosDestravados', false) == true &&
          (resource == null || resource.data.get('parametrosDestravados', false) != true);
      }
      allow delete: if souProfessorDaTurma(turmaDaEmpresa());

      // livros da empresa: saldos iniciais e Livro Diário (o aluno e o professor da turma)
      match /livros/{livro} {
        allow read, write: if livro in ['saldos', 'diario'] &&
          (souProfessorDaTurma(turmaDaEmpresa()) || minhaEmpresa());
      }
    }

    // ---------- suporte por chamados ----------
    match /chamados/{id} {
      // quem abriu vê os próprios chamados; o administrador vê todos
      allow read: if souAdmin() || (confirmado() && resource.data.autorUid == request.auth.uid);
      allow create: if souAdmin() || (confirmado() && request.resource.data.autorUid == request.auth.uid &&
        request.resource.data.status == 'aberto');
      // o administrador responde; quem abriu responde de volta, encerra ou reabre
      allow update: if souAdmin() || (confirmado() && resource.data.autorUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respostas', 'status', 'atualizadoEm']) &&
        request.resource.data.status in ['aberto', 'encerrado']);
      allow delete: if souAdmin();
    }

    // ---------- auditoria: entradas e ações importantes ----------
    match /auditoria/{id} {
      allow read: if souAdmin();
      allow create: if logado() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- senha do CTC (professor e administrador) ----------
    // senhas/{email}: só diz se a senha existe e guarda o "sal" (não é segredo)
    match /senhas/{email} {
      allow get: if logado() && ((autorizado() && email == meuEmail()) || souAdmin());
      allow list: if souAdmin();
      allow create: if autorizado() && email == meuEmail();
      allow update: if false;
      allow delete: if souAdmin();
    }
    // segredos/{email}: o hash da senha — ninguém lê, nem o próprio professor
    match /segredos/{email} {
      allow read, update: if false;
      allow create: if autorizado() && email == meuEmail() &&
        request.resource.data.keys().hasOnly(['senhaHash']);
      allow delete: if souAdmin();
    }

    // ---------- confirmação da entrada ----------
    match /sessoes/{uid} {
      allow read: if false;
      allow delete: if logado() && request.auth.uid == uid;
      allow create, update: if logado() && request.auth.uid == uid &&
        request.resource.data.validoAte is timestamp &&
        request.resource.data.validoAte <= request.time + duration.value(12, 'h') &&
        (sessaoProfessorConfere() || sessaoAlunoConfere());
    }
    // qualquer outra coleção fica fechada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
